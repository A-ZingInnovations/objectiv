# Objective sidecar (g5 pilot). Copy to .env.local
VITE_OBJECTIVE_SIDECAR_URL=http://127.0.0.1:8787
VITE_OBJECTIVE_PILOT_USER=pilot-local
# Optional: local path to vscode-extension (also editable in Settings)
VITE_OBJECTIVE_EXTENSION_PATH=
# Legacy hosted OpenVSCode (deprecated; use native Marketplace panel)
VITE_OBJECTIV_OPENVSCODE_HOSTED_URL=https://www.a-zing.org/openvscode
VITE_OBJECTIV_OPENVSCODE_TOKEN=
# Native marketplace catalog (production static host)
VITE_OBJECTIV_MARKETPLACE_CATALOG_URL=https://marketplace.project-objectiv.com/catalog.json

# Enterprise license server (online activate / refresh)
# VITE_OBJECTIV_LICENSE_URL=https://license.project-objectiv.com
# Or paste JWT / dev key locally:
# VITE_OBJECTIV_LICENSE_KEY=

# Org tag for Product settings (e.g. Objectiv rollout for A-Zing)
# VITE_OBJECTIV_ORG_TAG=Objectiv

# Lucid Compliances Slack (tags Messaging to lucidcompliances.slack.com)
# VITE_OBJECTIV_CHAT_PLATFORM=slack
# VITE_OBJECTIV_SLACK_WORKSPACE_TAG=Lucid Compliances
# VITE_OBJECTIV_SLACK_BOT_TOKEN=xoxb-…
# VITE_OBJECTIV_SLACK_CHANNEL_ID=C…

# Enterprise mail preset — mail.a-zing.org (requires valid license + password in .env.local)
# VITE_OBJECTIV_MAIL_IMAP_HOST=mail.a-zing.org
# VITE_OBJECTIV_MAIL_IMAP_USER=prasanna@a-zing.org
# VITE_OBJECTIV_MAIL_IMAP_PASSWORD=
