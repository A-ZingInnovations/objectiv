{
  "manifest": {
    "id": "azing.viewer.mongo-nosql",
    "name": "Mongo / NoSQL View",
    "publisher": "A-Zing Innovations",
    "version": "1.0.0",
    "description": "Compass-style table and JSON views for local NoSQL collections, JSONL imports, and Mongo URI scratch pads.",
    "kind": "viewer",
    "contributes": {
      "viewer": {
        "feature": "mongo-nosql",
        "activityTitle": "NoSQL / Mongo View",
        "fileExtensions": ["json", "jsonl", "ndjson"]
      },
      "snippets": [
        {
          "name": "mongo find filter",
          "language": "json",
          "body": "{\n  \"${1:field}\": ${2:value}\n}\n"
        },
        {
          "name": "mongosh find",
          "language": "javascript",
          "body": "db.${1:collection}.find(${2:{}}).limit(${3:20})\n"
        },
        {
          "name": "mongosh aggregate",
          "language": "javascript",
          "body": "db.${1:collection}.aggregate([\n  { $match: ${2:{}} },\n  { $limit: ${3:20} }\n])\n"
        }
      ]
    }
  }
}
