  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "typescript": "~5.6.3"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "node-pty@1.1.0": true
  }
}
