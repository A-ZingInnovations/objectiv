{
  "productName": "Objectiv",
  "version": "0.1.0",
  "identifier": "app.objectiv.editor",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../app",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../app",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Objectiv",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Objectiv (AZO) — A-Zing's Objectiv",
    "longDescription": "Objectiv (AZO) is A-Zing's Objectiv developer portal and IDE shell for the Objective agent.",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["objectiv"]
      }
    }
  }
}
